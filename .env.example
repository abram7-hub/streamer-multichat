# Streamer Multichat - example environment file
#
# The application does NOT read platform credentials from .env.
# Client IDs are entered in the in-app settings wizard; client secrets,
# API keys and OAuth tokens are entered in the app and stored encrypted
# (Electron safeStorage / Windows DPAPI) in the Electron userData directory.
# Never put real credentials in this file or commit a real .env file.

# Optional, development only: interval (ms) between generated messages
# in demo mode. Leave empty to use the default (1500).
DEMO_INTERVAL_MS=
